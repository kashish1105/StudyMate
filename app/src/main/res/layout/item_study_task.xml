<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlanTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:00 PM - 07:30 PM"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E65100" />

            <TextView
                android:id="@+id/tvPlanSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvPlanTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Topic: SQLite Database"
                android:textSize="14sp"
                android:textColor="#555555" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDeletePlan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Delete Schedule" />
    </LinearLayout>
</androidx.cardview.widget.CardView>